  "title": "潮汐试验场",
  "summary": "用于验收 RPG 开局、配置驱动角色创建、地点/NPC/势力绑定、客户端骰子、事件、成长、记忆权限与存档地图隔离的完整测试世界卡。",
  "coverImage": "",
  "tags": [
    "测试",
    "沙盒",
    "多地点",
    "冲突",
    "成长"
  ],
  "setting": {
    "premise": "海潮会携带记忆回声，玩家在被遗忘的灯塔群岛上寻找失踪的测绘队。",
    "history": "三方势力争夺潮汐核心，旧王国灯塔会在特定时间唤醒。",
    "geography": "白潮港、雾林、断崖灯塔与潮汐遗迹可往返。",
    "culture": "港口居民依靠潮汐历法生活，测绘员拥有跨势力通行权。",
    "currentSituation": "红潮提前到来，测绘队最后联络来自断崖灯塔。"
  },
  "rules": {
    "hard": [
      "玩家已知信息与世界真实信息分开保存。",
      "冲突判定由客户端骰子提供，AI 只叙述和提交结构化变化。",
      "地点、NPC、势力必须使用本卡稳定 ID。"
    ],
    "soft": [
      "允许绕过初始目标自由探索。",
      "AI 可在规则许可时创建新事件，但不得改写硬事实。"
    ]
  },
