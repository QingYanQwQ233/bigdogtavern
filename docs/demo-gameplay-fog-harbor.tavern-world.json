  "content": {
    "world": {
      "schemaVersion": 1,
      "id": "world-fog-harbor",
      "version": 1,
      "title": "雾港灯塔：红潮来信",
      "summary": "一个以调查、探索、交涉和轻量战斗为核心的港口冒险世界。每条线索都能改变路线，初始目标只是抓手而不是强制主线。",
      "coverImage": "",
      "tags": ["调查", "探索", "交涉", "战斗", "多路线", "成长"],
      "setting": {
        "premise": "白潮港收到一封来自失踪测绘队的红色潮纸信。信上只有一句话：不要让第十三声钟响起。",
        "history": "旧王国曾用灯塔群锁住海底的潮汐炉心。三十年前灯塔熄灭，港口把这段历史改写成了海难传说。",
        "geography": "白潮港、雾林旧路、断崖灯塔和潮汐地窖构成一条可以往返的调查路线。",
        "culture": "港民按潮汐钟安排生活，证据和信誉比武力更能打开港口的门。",
        "currentSituation": "红潮比预期提前两天，灯塔正在逐座亮起；议会想封锁消息，雾林守望者想让所有人离开。"
      },
      "rules": {
        "hard": [
          "玩家可以无视当前目标，任何行动都必须留下可追踪的世界后果。",
          "需要判定时由客户端掷骰；AI只能提出判定并叙述结果，不能伪造骰面。",
          "世界真实信息、玩家已知信息和 NPC 私密信息分开处理。",
          "地点、NPC、势力、线索使用本卡稳定 ID；新增实体必须有明确来源。"
        ],
        "soft": [
          "优先让调查产生新问题，而不是用单一正确答案结束场景。",
          "失败不回档：可以负伤、失去资源、被监视或换一条路继续。",
          "玩家可以自己提出不在选项里的行动，选项只提供当前可见抓手。"
        ],
        "checks": [
          { "id": "inspect-clue", "label": "调查线索", "description": "理解现场、地图和物证。", "roll": "1d20", "target": 11, "modifier": { "bucket": "attributes", "id": "insight", "factor": 1 } },
          { "id": "negotiate-faction", "label": "势力交涉", "description": "争取通行、档案或援助。", "roll": "1d20", "target": 12, "modifier": 1 },
          { "id": "survive-fog", "label": "雾林求生", "description": "在潮雾、旧路和追踪者之间保持方向。", "roll": "1d20", "target": 13, "modifier": 1 }
        ]
      },
      "playerCreation": {
        "mode": "custom",
        "title": "建立雾港旅者",
        "description": "选择一个出身预设即可开始；也可以自由分配 16 点属性点。不同出身只提供倾向，不锁死路线。",
        "pointBudget": { "label": "属性点", "total": 16, "min": 1, "mode": "pool", "cost": "above-min" },
        "defaultPresetId": "dock-investigator",
        "buildPresets": [
          {
            "id": "dock-investigator",
            "label": "码头调查员",
            "description": "擅长观察和交涉，适合先走港口档案线。",
            "values": { "attributes": { "might": 3, "agility": 4, "insight": 6, "nerve": 4 }, "skills": { "investigate": 4, "negotiate": 3, "survival": 1 }, "traits": ["ledger-eye"] }
          },
          {
            "id": "fog-runner",
            "label": "雾林信使",
            "description": "速度和求生优先，适合绕开封锁直奔灯塔。",
            "values": { "attributes": { "might": 3, "agility": 6, "insight": 4, "nerve": 4 }, "skills": { "investigate": 2, "negotiate": 1, "survival": 5 }, "traits": ["fog-memory"] }
          },
          {
            "id": "salvage-guard",
            "label": "打捞护卫",
            "description": "更能承受战斗风险，适合测试冲突和资源代价。",
            "values": { "attributes": { "might": 6, "agility": 3, "insight": 3, "nerve": 5 }, "skills": { "investigate": 1, "negotiate": 2, "survival": 4 }, "traits": ["brine-guard"] }
          }
        ],
        "fields": [
          { "id": "name", "label": "角色名", "type": "text", "required": true, "maxLength": 80 },
          { "id": "origin", "label": "出身", "type": "select", "required": true, "options": [{ "value": "白潮港", "label": "白潮港" }, { "value": "雾林边民", "label": "雾林边民" }, { "value": "外海漂泊者", "label": "外海漂泊者" }], "default": "白潮港" },
          { "id": "identity", "label": "当前身份", "type": "textarea", "required": true, "maxLength": 1000 },
          { "id": "appearance", "label": "外貌", "type": "textarea", "maxLength": 1200 },
          { "id": "personality", "label": "性格", "type": "textarea", "maxLength": 1200 },
          { "id": "customNotes", "label": "自定义补充", "type": "textarea", "maxLength": 2400 }
        ],
        "attributes": [
          { "id": "might", "label": "力量", "min": 1, "max": 8, "default": 3, "step": 1 },
          { "id": "agility", "label": "灵巧", "min": 1, "max": 8, "default": 3, "step": 1 },
          { "id": "insight", "label": "洞察", "min": 1, "max": 8, "default": 3, "step": 1 },
          { "id": "nerve", "label": "胆识", "min": 1, "max": 8, "default": 3, "step": 1 }
        ],
        "skills": [
          { "id": "investigate", "label": "调查", "description": "阅读物证、地图和口供。", "min": 0, "max": 10, "default": 1, "step": 1 },
          { "id": "negotiate", "label": "交涉", "description": "在不同势力之间交换承诺。", "min": 0, "max": 10, "default": 1, "step": 1 },
          { "id": "survival", "label": "求生", "description": "处理潮雾、旧路和危险地形。", "min": 0, "max": 10, "default": 1, "step": 1 }
        ],
        "resources": [
          { "id": "hp", "label": "生命", "type": "number", "min": 1, "max": 100, "initial": 20 },
          { "id": "focus", "label": "专注", "type": "number", "min": 0, "max": 30, "initial": 8 },
          { "id": "shells", "label": "潮贝", "type": "number", "min": 0, "max": 9999, "initial": 35 }
        ],
        "derived": [
          { "id": "field-readiness", "label": "野外准备", "formula": "attributes.agility + skills.survival", "description": "长途移动和撤退的基础准备度。" },
          { "id": "case-leverage", "label": "案情筹码", "formula": "attributes.insight + skills.negotiate", "description": "在听证、交易和逼问中的基础筹码。" }
        ],
        "traits": [
          { "id": "ledger-eye", "label": "账册眼", "description": "能从货单和账册里发现不一致。" },
          { "id": "fog-memory", "label": "雾中记路", "description": "曾在潮雾里走过很远，迷路后仍能留下退路。" },
          { "id": "brine-guard", "label": "盐潮护身", "description": "在海上打捞事故中活下来，第一次受伤时额外保留 2 点生命。" },
          { "id": "bell-debt", "label": "钟债", "description": "你曾向灯塔借过一次庇护，旧债可能在关键时刻找上门。" }
        ],
        "choiceBudget": { "label": "特质选择数", "total": 2, "min": 0 },
        "choices": [
          { "id": "ledger-eye", "label": "账册眼", "kind": "trait", "cost": 1, "description": "调查港口记录时获得额外线索。" },
          { "id": "fog-memory", "label": "雾中记路", "kind": "trait", "cost": 1, "description": "雾林追踪失败时保留一条退路。" },
          { "id": "brine-guard", "label": "盐潮护身", "kind": "trait", "cost": 1, "description": "战斗失败时减少一次资源损失。" },
          { "id": "bell-debt", "label": "钟债", "kind": "flaw", "cost": 0, "description": "灯塔相关 NPC 更容易认出你，但会提出额外要求。" }
        ],
        "relations": [
          { "npcId": "npc-mira", "min": -100, "max": 100, "default": 10 },
          { "npcId": "npc-oren", "min": -100, "max": 100, "default": 0 },
          { "npcId": "npc-sable", "min": -100, "max": 100, "default": -5 }
        ],
        "initialInventory": [{ "itemId": "tide-compass", "count": 1 }, { "itemId": "field-rations", "count": 2 }, { "itemId": "lantern-oil", "count": 1 }],
        "economy": {
          "inventory": { "enabled": true, "maxSlots": 12, "maxWeight": 24, "items": [
            { "id": "tide-compass", "label": "潮汐罗盘", "weight": 0.6, "maxStack": 1 },
            { "id": "field-rations", "label": "野外口粮", "weight": 0.5, "maxStack": 10 },
            { "id": "lantern-oil", "label": "灯油", "weight": 0.4, "maxStack": 10 },
            { "id": "red-letter", "label": "红潮来信", "weight": 0.1, "maxStack": 1 }
          ] },
          "equipment": { "enabled": true, "slots": [{ "id": "hand", "label": "手持" }, { "id": "body", "label": "身体" }] },
          "currencies": [{ "id": "shells", "label": "潮贝", "min": 0, "max": 9999, "initial": 35 }]
        },
        "growth": {
          "sources": [
            { "id": "casework", "label": "案件推进", "kind": "exploration", "description": "确认关键事实后获得成长。" },
            { "id": "alliances", "label": "势力关系", "kind": "relationship", "description": "用行动改变势力态度。" }
          ],
          "candidates": [
            { "id": "read-the-tide", "label": "读潮", "sourceId": "casework", "bucket": "skills", "targetId": "investigate", "delta": 1, "description": "解开第一份灯塔记录后提升调查。" },
            { "id": "trusted-witness", "label": "可靠证人", "sourceId": "alliances", "bucket": "identity", "targetId": "calling", "value": "红潮见证者", "description": "至少两方势力承认你的证词。" }
          ]
        }
      },
      "turnContract": { "options": { "min": 3, "max": 4 }, "actionIntent": true },
      "failure": {
        "defaultMode": "continue",
        "onZeroHp": "injured",
        "onConflictDefeat": "resource-loss",
        "modes": [
          { "id": "continue", "label": "带着代价继续", "description": "失败改变局面，但不替玩家结束故事。" },
          { "id": "injured", "label": "负伤", "description": "保留世界线并附加负伤状态。", "hpRatio": 0.25, "effect": "负伤" },
          { "id": "resource-loss", "label": "资源损失", "description": "失去潮贝、口粮或线索位置，换取继续行动。", "resourceLoss": { "shells": 8 } },
          { "id": "captured", "label": "被扣留", "description": "被某一方暂时控制，后续仍可脱身。", "effect": "被扣留" }
        ]
      },
      "ending": {
        "enabled": true,
        "allowPlayerEnd": true,
        "requireConfirm": true,
        "defaultEndingId": "player-choice",
        "endings": [
          { "id": "player-choice", "kind": "player-choice", "label": "玩家主动结束", "description": "保留当前存档并结束本次航线。", "terminal": true },
          { "id": "lighthouse-silent", "kind": "card-defined", "label": "灯塔沉默", "description": "你让潮汐炉心重新沉睡，港口付出了代价。", "terminal": true },
          { "id": "lighthouse-open", "kind": "card-defined", "label": "灯塔开放", "description": "你公开真相，让雾港进入新的航海时代。", "terminal": true }
        ]
      },
      "conflicts": [
        {
          "id": "reef-ambush",
          "label": "礁滩伏击",
          "type": "combat",
          "description": "潮雾中的拾荒者被某种发光的礁兽逼到退潮线。",
          "maxRounds": 5,
          "phases": [{ "id": "warning", "label": "预警" }, { "id": "clash", "label": "交锋" }],
          "actions": [
            { "id": "hold-line", "label": "守住退潮线", "description": "以力量稳住阵脚。", "check": { "roll": "1d20", "modifier": { "bucket": "attributes", "id": "might", "factor": 1 }, "target": 12, "damage": { "roll": "1d6", "modifier": { "bucket": "skills", "id": "survival", "factor": 1 } } } },
            { "id": "signal-lighthouse", "label": "用灯油发信号", "description": "消耗灯油，让灯塔短暂照亮礁滩。" },
            { "id": "retreat", "label": "撤向仓库", "description": "放弃一部分物资，先保住行动机会。" }
          ],
          "outcomes": [
            { "id": "driven-off", "label": "击退礁兽", "consequences": ["获得一块会发光的黑珊瑚。", "萨布尔暂时相信你的实力。"] },
            { "id": "costly-retreat", "label": "带着损失撤退", "consequences": ["失去一份口粮，礁兽仍留在退潮线。"] }
          ]
        },
        {
          "id": "council-hearing",
          "label": "议会听证",
          "type": "social",
          "description": "港口议会要求你交出红潮来信，并说明为何不该立刻封港。",
          "maxRounds": 4,
          "phases": [{ "id": "question", "label": "质询" }, { "id": "verdict", "label": "裁定" }],
          "actions": [
            { "id": "present-ledger", "label": "出示账册矛盾", "description": "以调查和证据争取米拉。", "check": { "roll": "1d20", "modifier": { "bucket": "skills", "id": "negotiate", "factor": 1 }, "target": 12 } },
            { "id": "name-the-risk", "label": "公开第十三声钟", "description": "让恐惧成为谈判筹码。" },
            { "id": "leave-hearing", "label": "拒绝回答", "description": "保留秘密，但会被议会标记。" }
          ],
          "outcomes": [
            { "id": "archive-access", "label": "开放档案", "consequences": ["获得潮汐档案室通行。", "港口议会关系提高。"] },
            { "id": "watched", "label": "受到监视", "consequences": ["港口行动难度提高，但封锁消息提前暴露。"] }
          ]
        },
        {
          "id": "fogwood-crossing",
          "label": "雾林过境",
          "type": "stealth",
          "description": "守望者的巡逻线切断了通往灯塔的旧路。",
          "maxRounds": 5,
          "phases": [{ "id": "track", "label": "找路" }, { "id": "cross", "label": "过境" }],
          "actions": [
            { "id": "read-old-road", "label": "辨认旧路", "description": "用罗盘和地图判断哪条雾带会回到灯塔。", "check": { "roll": "1d20", "modifier": { "bucket": "skills", "id": "investigate", "factor": 1 }, "target": 13 } },
            { "id": "talk-to-oren", "label": "向奥伦表明来意", "description": "以承诺换取安全通行。" },
            { "id": "wait-for-bell", "label": "等钟声引路", "description": "浪费时间，但减少迷路风险。" }
          ],
          "outcomes": [
            { "id": "shortcut", "label": "找到捷径", "consequences": ["提前抵达断崖灯塔。", "发现一处被隐藏的旧路标。"] },
            { "id": "turned-around", "label": "被雾带回入口", "consequences": ["时间推进一格，守望者开始追问你的目的。"] }
          ]
        }
      ],
      "time": { "unit": "潮汐时", "start": 5, "turnAdvance": 1 },
      "events": [
        { "id": "red-tide-rises", "title": "红潮提前上涨", "description": "海面变成暗红色，第一座灯塔亮起。", "trigger": { "at": 7 }, "visibility": "public", "once": true, "consequences": ["断崖灯塔开放一条隐藏入口。"] },
        { "id": "thirteenth-bell", "title": "第十三声钟", "description": "港口钟楼多响了一声，所有 NPC 对同一段历史产生不同说法。", "trigger": { "afterTurns": 3 }, "visibility": "public", "once": true, "consequences": ["议会开始封存档案，雾林巡逻增加。"] },
        { "id": "harbor-lockdown", "title": "白潮港封锁", "description": "议会暂时关闭码头，离港需要交出一条线索。", "trigger": { "locationId": "brine-quay" }, "visibility": "public", "once": true, "consequences": ["港口进入紧张状态。"] }
      ],
      "factions": [
        {
          "id": "faction-council",
          "name": "白潮港议会",
          "description": "控制码头、档案和港口封锁令。",
          "goals": ["维持航运秩序", "阻止潮汐炉心消息外泄"],
          "resources": [{ "id": "authority", "label": "行政权", "min": 0, "max": 100, "initial": 58 }],
          "actions": [{ "id": "seal-quay", "title": "封锁码头", "description": "红潮上涨后限制出入。", "trigger": { "at": 7, "locationId": "brine-quay" }, "changes": { "authority": 3 }, "consequences": ["码头检查变严。"] }],
          "initialState": { "relation": 10, "influence": 58, "resources": { "authority": 58 } }
        },
        {
          "id": "faction-keepers",
          "name": "雾林守望者",
          "description": "保护旧路和口述记忆，不相信议会的封港理由。",
          "goals": ["阻止炉心被再次唤醒", "保护失踪者记录"],
          "resources": [{ "id": "trust", "label": "部族信任", "min": 0, "max": 100, "initial": 36 }],
          "actions": [{ "id": "move-patrols", "title": "调动巡逻", "description": "玩家公开炉心线索后加强雾林巡逻。", "trigger": { "afterTurns": 3, "locationId": "fogwood-gate" }, "changes": { "trust": -2 }, "consequences": ["旧路更难穿过。"] }],
          "initialState": { "relation": 0, "influence": 36, "resources": { "trust": 36 } }
        },
        {
          "id": "faction-salvagers",
          "name": "潮痕打捞行",
          "description": "靠回收遗迹碎片生存的松散行会，愿意交换危险情报。",
          "goals": ["找到黑珊瑚钥匙", "在封港前装满一条船"],
          "resources": [{ "id": "stock", "label": "遗物库存", "min": 0, "max": 100, "initial": 42 }],
          "actions": [{ "id": "move-stock", "title": "转移遗物", "description": "看到红潮后把库存移向灯塔。", "trigger": { "at": 7, "locationId": "brine-quay" }, "changes": { "stock": -4 }, "consequences": ["黑市交易变得活跃。"] }],
          "initialState": { "relation": -5, "influence": 20, "resources": { "stock": 42 } }
        }
      ],
      "start": {
        "locationId": "brine-quay",
        "openingMode": "ai",
        "opening": "你在潮汐钟响起第五声时抵达白潮港，怀里只有一封湿透的红潮来信。",
        "playerTemplate": { "name": "未命名旅者", "race": "人类", "role": "雾港调查者", "profileFields": [] },
        "initialState": {
          "stats": { "level": 1, "exp": 0, "expNext": 100, "hp": 20, "maxHp": 20, "mp": 8, "maxMp": 8, "gold": 35, "buffs": [] },
          "inventory": [{ "name": "潮汐罗盘", "count": 1, "desc": "指向最近的异常潮声。" }, { "name": "野外口粮", "count": 2 }, { "name": "灯油", "count": 1 }, { "name": "红潮来信", "count": 1, "desc": "写着不要让第十三声钟响起。" }],
