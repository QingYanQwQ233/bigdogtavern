  "content": {
    "world": {
      "id": "world-mui10p9r-3e2921c2b97b",
      "version": 8,
      "title": "矿坑之路：失落矿坑 · 第一章",
      "summary": "D&D 失落矿坑第一章完整复刻：地精伏击 → 追迹小径 → 洞穴八间（岗哨/狼舍/陡道/天桥/地精窝/双池/首领洞）→ 营救西尔达 → 直面克拉格。世界卡声明驱动的完整地城冒险。",
      "tags": [
        "D&D",
        "地城",
        "复刻",
        "完整版"
      ],
      "lorebookIds": [],
      "locations": [
        {
          "id": "ambush-site",
          "name": "伏击现场",
          "type": "road",
          "summary": "北大道弯道：死马、货车与消失的人。",
          "tags": [
            "起点",
            "调查"
          ]
        },
        {
          "id": "goblin-trail",
          "name": "嚼齿小径",
          "type": "forest-path",
          "summary": "密林深处的野路，藏着两道陷阱。",
          "tags": [
            "追踪",
            "危险"
          ]
        },
        {
          "id": "cave-mouth",
          "name": "溪谷洞口",
          "type": "cave-entrance",
          "summary": "灌木遮掩的洞穴入口，深处有流水声。",
          "tags": [
            "钩子",
            "入口"
          ]
        },
        {
          "id": "goblin-blind",
          "name": "灌木岗哨",
          "type": "cave-room",
          "summary": "洞口东侧，两丛灌木后蹲着值守的地精。",
          "tags": [
            "洞内",
            "前哨"
          ]
        },
        {
          "id": "kennel",
          "name": "狼舍",
          "type": "cave-room",
          "summary": "三只被拴住的狼，低吼着盯住来人。",
          "tags": [
            "洞内",
            "兽栏"
          ]
        },
        {
          "id": "steep-passage",
          "name": "陡峭石道",
          "type": "cave-room",
          "summary": "湿滑的石阶向上，一侧是深水。",
          "tags": [
            "洞内",
            "险路"
          ]
        },
        {
          "id": "overpass",
          "name": "石桥天桥",
          "type": "cave-room",
          "summary": "横跨水道的石桥，桥头有地精放哨；桥下水坝可开闸。",
          "tags": [
            "洞内",
            "机关"
          ]
        },
        {
          "id": "goblin-den",
          "name": "地精窝",
          "type": "cave-room",
          "summary": "堆着毛皮与骨头的空场，角落里锁着一个穿旧罩袍的男人。",
          "tags": [
            "洞内",
            "囚室"
          ]
        },
        {
          "id": "twin-pools",
          "name": "双池水坝",
          "type": "cave-room",
          "summary": "两汪深水被石块垒成的堰坝截住，水声轰鸣。",
          "tags": [
            "洞内",
            "机关"
          ]
        },
        {
          "id": "klarg-cave",
          "name": "克拉格的巢穴",
          "type": "cave-room",
          "summary": "火塘、铺满兽皮的高台，一只熊地精的窝。",
          "tags": [
            "洞内",
            "首领"
          ]
        }
      ],
      "npcs": [
        {
          "id": "goblin-scout",
          "name": "地精斥候",
          "role": "伏击者",
          "description": "藏身在林间的瘦小身影，弓弦拉满。",
          "persona": "谨慎、贪婪、欺软怕硬。",
          "locationId": "ambush-site",
          "publicFacts": [
            "属于嚼齿部落"
          ],
          "publicGoals": [
            "劫掠落单的商队"
          ],
          "secrets": [
            {
              "id": "scout-orders",
              "content": "他们接到的命令是：专门等一辆矮人的货车。"
            }
          ]
        },
        {
          "id": "goblin-prisoner",
          "name": "地精俘虏",
          "role": "被制服的伏击者",
          "description": "手脚被捆住，牙齿磨得尖利，眼神躲闪。",
          "persona": "惜命、狡猾，被吓住就会开口。",
          "locationId": "ambush-site",
          "publicFacts": [
            "参与了伏击"
          ],
          "publicGoals": [
            "换一条命"
          ],
          "secrets": [
            {
              "id": "prisoner-knows",
              "content": "部落巢穴在溪谷尽头；头目克拉格——一只熊地精——收了「黑蜘蛛」的钱，专门等这辆货车；矮人和他的护卫被活着送进了洞里。"
            }
          ]
        },
        {
          "id": "gundren",
          "name": "贡德伦·寻脉",
          "role": "雇主 · 矮人勘矿者（失踪）",
          "description": "胡子沾着岩灰的矮人，谈矿脉时眼睛发亮。",
          "persona": "固执、慷慨、对路线守口如瓶。",
          "publicFacts": [
            "雇了车队送补给",
            "先行前往凡戴尔"
          ],
          "publicGoals": [
            "赶到镇上登记矿脉发现"
          ],
          "secrets": [
            {
              "id": "gundren-map",
              "content": "他随身带着矿脉入口的地图。抓他的人，冲的就是这张图。"
            }
          ]
        },
        {
          "id": "sildar",
          "name": "西尔达·寒泉",
          "role": "护卫 · 老兵（失踪）",
          "description": "披着旧罩袍的战士，剑柄磨得发亮。",
          "persona": "寡言、可靠，习惯走队伍最后。",
          "publicFacts": [
            "与贡德伦同行"
          ],
          "publicGoals": [
            "把雇主安全送到凡戴尔"
          ],
          "secrets": [
            {
              "id": "sildar-captive",
              "content": "他护卫雇主时被一并掳走，如今被关在巢穴深处。"
            }
          ]
        },
        {
          "id": "klarg",
          "name": "克拉格",
          "role": "熊地精首领",
          "description": "比普通地精高出一个头，皮毛灰黑，戴着铁项圈。",
          "persona": "贪婪、暴躁，对「黑蜘蛛」的命令唯命是从。",
          "locationId": "klarg-cave",
          "publicFacts": [
            "部落的头目"
          ],
          "publicGoals": [
            "守住货、等赏钱"
          ],
          "secrets": [
            {
              "id": "klarg-orders",
              "content": "「黑蜘蛛」出钱让他抓矮人，并把人和随身的图送去克拉格城堡。"
            }
          ]
        },
        {
          "id": "yeemik",
          "name": "耶米克",
          "role": "地精副手",
          "description": "瘦高、油滑，说话时总往克拉格的方向瞟。",
          "persona": "阴险、怕死，想取而代之。",
          "locationId": "goblin-den",
          "publicFacts": [
            "克拉格的手下"
          ],
          "publicGoals": [
            "取代克拉格"
          ],
          "secrets": [
            {
              "id": "yeemik-plot",
              "content": "他愿意出卖克拉格——只要价钱合适。"
            }
          ]
        },
        {
          "id": "wolf-pack",
          "name": "狼群",
          "role": "兽栏里的三只狼",
          "description": "瘦骨嶙峋，被铁链拴在石壁的环上。",
          "persona": "凶、怕饿，喂过食就不咬。",
          "locationId": "kennel",
          "publicFacts": [
            "被地精拴着"
          ],
          "publicGoals": [
            "撕碎靠近的东西"
          ]
        }
      ],
